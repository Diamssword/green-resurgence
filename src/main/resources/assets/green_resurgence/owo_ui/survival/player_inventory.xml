<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="horizontal">
            <children>


                <flow-layout direction="vertical" id="maingrid">

                    <children>
                        <flow-layout id="equipmentsPanel" direction="horizontal">
                                    <children>
                                        <flow-layout direction="horizontal" id="extraSlotsLayout">
                                            <children>
                                                <inventory name="disabled" id="bags" width="1" height="3"
                                                           texture="red.png"/>
                                            </children>
                                        </flow-layout>
                                        <inventory name="disabled" id="armor" width="1" height="4" texture="lila.png"/>
                                    </children>

                                    <padding>
                                        <all>4</all>
                                    </padding>
                            <positioning type="absolute">0,0</positioning>
                                </flow-layout>

                        <flow-layout direction="horizontal" id="backpackMainLayout">
                            <children>

                                <flow-layout direction="horizontal">
                                    <children>
                                     <inventory id="backpack" name="disabled" width="1" height="1" texture="blue.png"/>
                                    </children>

                                    <allow-overflow>true</allow-overflow>
                                </flow-layout>

                            </children>
                             <padding>
                                <top>4</top>
                                <bottom>5</bottom>
                            </padding>
                            <allow-overflow>true</allow-overflow>
                            <vertical-alignment>bottom</vertical-alignment>
                            <horizontal-alignment>center</horizontal-alignment>
                        </flow-layout>

                        <flow-layout direction="horizontal" id="'centerInventoryLayout">
                                    <children>
                                        <flow-layout direction="horizontal" id="satchelPadderLeft"><children/></flow-layout>
                                        <flow-layout direction="horizontal">
                                            <children>
                                                <inventory id="satchelLeft" name="disabled" width="1" height="3"
                                                           texture="orange.png">
                                                </inventory>
                                            </children>
                                             <padding><right>4</right><left>4</left></padding>
                                            <z-index>1</z-index>
                                            <allow-overflow>true</allow-overflow>
                                        </flow-layout>
                                        <flow-layout direction="horizontal">
                                            <children>
                                                <inventory id="player" name="disabled" width="3" height="3"
                                                           texture="light_green.png"/>
                                            </children>
                                            <allow-overflow>true</allow-overflow>
                                            <padding><horizontal>12</horizontal></padding>
                                        </flow-layout>
                                        <flow-layout direction="horizontal">
                                            <children>
                                                   <inventory id="satchelRight" name="disabled" width="1" height="3"
                                                              texture="orange.png"/>
                                            </children>
                                             <padding><right>4</right><left>4</left></padding>
                                            <z-index>1</z-index>
                                        <allow-overflow>true</allow-overflow>
                                        </flow-layout>
                                        <flow-layout direction="vertical" id="satchelPadderRight"><children/></flow-layout>
                                    </children>
                                        <allow-overflow>true</allow-overflow>
                                    <padding>
                                        <top>4</top>
                                        <bottom>5</bottom>
                                    </padding>

                            <z-index>2</z-index>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <vertical-alignment>center</vertical-alignment>
                        </flow-layout>
                        <flow-layout direction="horizontal">
                            <children>
                                <flow-layout direction="horizontal" id="offHandPanel">
                                    <children>
                                        <inventory name="disabled" id="offhand" width="1" height="1"
                                                   texture="yellow.png"/>
                                    </children>
                                    <positioning type="absolute">-30,0</positioning>
                                </flow-layout>
                                <inventory id="hotbar" width="9" height="1" texture="cyan.png"/>
                            </children>
                            <z-index>1</z-index>
                            <margins><top>4</top><horizontal>5</horizontal></margins>
                            <padding>
                                <all>4</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <vertical-alignment>center</vertical-alignment>
                        </flow-layout>
                    </children>
                    <horizontal-alignment>center</horizontal-alignment>
                    <vertical-alignment>center</vertical-alignment>
                    <allow-overflow>true</allow-overflow>
                </flow-layout>
                <flow-layout direction="horizontal" id="blank_space"><children/>
                    <sizing><horizontal method="fixed">40</horizontal></sizing>
                </flow-layout>
                <subscreen id="subcontainer" source="survival/player_stats">
                    <sizing>
                        <vertical method="fill">100</vertical>
                        <horizontal method="fill">50</horizontal>
                    </sizing>
                    <positioning type="relative">100,50</positioning>
                </subscreen>
            </children>
            <surface>
                <vanilla-translucent/>
            </surface>
            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>
            <sizing>
                <vertical method="fill">100</vertical>
                <horizontal method="fill">100</horizontal>
            </sizing>
        </flow-layout>
    </components>
</owo-ui>
