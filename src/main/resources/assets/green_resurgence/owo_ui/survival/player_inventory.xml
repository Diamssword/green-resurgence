<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
    <components>
        <flow-layout direction="horizontal">
            <children>
                <flow-layout direction="horizontal" id="leftMenu">
                    <children>
                        <flow-layout direction="vertical" id="subPanelButtons">
                            <children>
                            </children>
                            <sizing>
                                <horizontal method="fixed">20</horizontal>
                            </sizing>
                        </flow-layout>
                        <flow-layout direction="vertical" id="layoutSubPanels">
                            <children>
                                <subscreen id="subpanels" source="survival/empty">
                                    <sizing><horizontal method="fixed">0</horizontal></sizing>
                                </subscreen>
                            </children>

                        </flow-layout>
                    </children>
                    <sizing>
                        <vertical method="fill">80</vertical>
                    </sizing>
                    <positioning type="relative">0,50</positioning>
                </flow-layout>

                <grid-layout rows="4" columns="2" id="maingrid">
                    <children>
                        <flow-layout row="0" column="1" direction="horizontal">
                            <children>
                                <freerowgrid columns="5" id="bonusLayout">
                                    <children/>
                                </freerowgrid>
                            </children>
                            <sizing><horizontal method="fixed">120</horizontal></sizing>
                            <horizontal-alignment>left</horizontal-alignment>
                        </flow-layout>
                         <flow-layout row="3" column="1" direction="horizontal">
                            <children>
                                <freerowgrid columns="5" id="malusLayout">
                                    <children/>
                                </freerowgrid>
                            </children>
                            <sizing><horizontal method="fixed">120</horizontal></sizing>
                            <horizontal-alignment>left</horizontal-alignment>
                        </flow-layout>
                        <flow-layout row="1" column="0" direction="horizontal">
                            <children>
                                <flow-layout direction="horizontal" id="extraSlotsLayout">
                                    <children>
                                        <inventory name="disabled" id="bags" width="1" height="3" texture="red.png"/>
                                    </children>
                                </flow-layout>
                                <inventory name="disabled" id="armor" width="1" height="4" texture="lila.png"/>
                            </children>
                            <surface>
                                <gpanel/>
                            </surface>
                            <padding>
                                <all>4</all>
                            </padding>
                            <margins><left>5</left></margins>
                            <horizontal-alignment>right</horizontal-alignment>
                        </flow-layout>
                        <flow-layout row="1" column="1" direction="vertical" id="'flow3">
                                    <children>
                                        <inventory id="backpack" name="disabled" width="1" height="1"
                                                   texture="blue.png">
                                            <margins>
                                                <bottom>5</bottom>
                                            </margins>
                                        </inventory>

                                        <flow-layout direction="horizontal">
                                            <children>
                                                <inventory id="satchelLeft" name="disabled" width="1" height="3"
                                                           texture="orange.png">
                                                </inventory>
                                                <inventory id="player" name="disabled" width="3" height="3"
                                                           texture="light_green.png"/>
                                                <inventory id="satchelRight" name="disabled" width="1" height="3"
                                                           texture="orange.png"/>
                                            </children>
                                            <gap>5</gap>
                                        </flow-layout>
                                    </children>
                                    <surface>
                                        <gpanel/>
                                    </surface>
                                    <padding>
                                        <all>4</all>
                                    </padding>
                                    <margins>
                                        <bottom>5</bottom>
                                        <horizontal>5</horizontal>
                                    </margins>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <vertical-alignment>center</vertical-alignment>
                        </flow-layout>
                        <flow-layout row="2" column="0" direction="horizontal" id="flowOffhand">
                            <children>
                                <flow-layout direction="vertical">
                                    <children>
                                        <inventory name="disabled" id="offhand" width="1" height="1"
                                                   texture="yellow.png"/>
                                    </children>
                                    <surface>
                                        <gpanel/>
                                    </surface>
                                    <padding>
                                        <all>4</all>
                                    </padding>
                                    <horizontal-alignment>center</horizontal-alignment>
                                    <vertical-alignment>center</vertical-alignment>
                                </flow-layout>
                            </children>
                            <horizontal-alignment>right</horizontal-alignment>
                        </flow-layout>
                        <flow-layout row="2" column="1" direction="horizontal">
                            <children>
                                <inventory id="hotbar" width="9" height="1" texture="cyan.png"/>
                            </children>
                            <surface>
                                <gpanel/>
                            </surface>
                            <margins><horizontal>5</horizontal></margins>
                            <padding>
                                <all>4</all>
                            </padding>
                            <horizontal-alignment>center</horizontal-alignment>
                            <vertical-alignment>center</vertical-alignment>
                        </flow-layout>
                    </children>
                    <horizontal-alignment>center</horizontal-alignment>
                    <vertical-alignment>center</vertical-alignment>
                </grid-layout>
                <flow-layout direction="horizontal" id="blank_space"><children/>
                    <sizing><horizontal method="fixed">40</horizontal></sizing>
                </flow-layout>
                <subscreen id="subcontainer" source="survival/player_stats">
                    <sizing>
                        <vertical method="fill">100</vertical>
                        <horizontal method="fill">50</horizontal>
                    </sizing>
                    <positioning type="relative">100,50</positioning>
                </subscreen>
            </children>
            <surface>
                <vanilla-translucent/>
            </surface>
            <vertical-alignment>center</vertical-alignment>
            <horizontal-alignment>center</horizontal-alignment>
            <sizing>
                <vertical method="fill">100</vertical>
                <horizontal method="fill">100</horizontal>
            </sizing>
        </flow-layout>
    </components>
</owo-ui>
