<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
<components>
<flow-layout direction="vertical">
    <children>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="vertical">
                    <children>
                         <flow-layout direction="horizontal" id="statsPanel">
                            <children/>
                            <gap>2</gap>
                            <padding><all>2</all></padding>
                            <margins><all>5</all></margins>
                            <surface>
                                <flat>#bb7d25</flat>
                            </surface>
                            <sizing><horizontal method="fill">100</horizontal></sizing>
                        </flow-layout>
                    </children>
                      <surface><gpanel/></surface>
                </flow-layout>

                <flow-layout direction="vertical">
                    <children>
                        <scroll direction="vertical">
                            <flow-layout direction="vertical" id="emoteLayout">
                                <children>

                                </children>
                                <sizing><horizontal method="fill">100</horizontal></sizing>
                            </flow-layout>
                            <sizing><vertical method="fill">100</vertical><horizontal method="fill">100</horizontal></sizing>
                        </scroll>
                    </children>
                    <surface><gpanel/></surface>
                    <sizing>
                        <horizontal method="fill">100</horizontal>
                        <vertical method="fill">40</vertical>
                    </sizing>
                </flow-layout>
            </children>
            <gap>5</gap>
            <sizing><horizontal method="fixed">100</horizontal></sizing>
        </flow-layout>

    </children>

    <horizontal-alignment>left</horizontal-alignment>
    <vertical-alignment>center</vertical-alignment>
</flow-layout>

</components>
</owo-ui>
