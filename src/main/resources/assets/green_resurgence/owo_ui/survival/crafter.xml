<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.20/owo-ui.xsd">
<components>
<flow-layout direction="horizontal">
    <children>
        <flow-layout direction="vertical">
            <children>
                <flow-layout direction="horizontal">
                    <children>
                        <flow-layout direction="vertical">
                            <children>
                                <text-box id="craftlist_search">
                                    <active>true</active>
                                    <show-background>false</show-background>
                                    <sizing><horizontal method="fill">100</horizontal></sizing>
                                    <margins><all>2</all><bottom>0</bottom></margins>
                                </text-box>
                                <scroll direction="vertical">
                                    <buttoninventory id="list" collection="empty">
                                    </buttoninventory>
                                    <padding><all>3</all><top>0</top></padding>
                                    <sizing><vertical method="fill">90</vertical><horizontal
                                            method="fill">100</horizontal></sizing>
                                </scroll>
                            </children>
                            <surface><craft search="true">#AF947B</craft></surface>
                            <sizing><horizontal method="fill">50</horizontal></sizing>
                        </flow-layout>

                        <flow-layout direction="vertical">
                            <children>
                                <recipedisplay id="display">
                                    <sizing><vertical method="fill">70</vertical><horizontal
                                            method="fill">100</horizontal></sizing>
                                </recipedisplay>
                                <button id="craft">
                                    <text>Crafter</text>
                                    <margins><top>5</top></margins>
                                </button>
                            </children>
                            <horizontal-alignment>center</horizontal-alignment>
                            <sizing><vertical method="fill">100</vertical><horizontal method="fill">50</horizontal></sizing>
                        </flow-layout>
                    </children>
                    <sizing><vertical method="fill">100</vertical><horizontal method="fill">100</horizontal></sizing>
                </flow-layout>

            </children>
            <padding><all>5</all></padding>  <sizing>
                        <horizontal method="fill">100</horizontal>
                        <vertical method="fill">50</vertical>
                    </sizing>
                    <horizontal-alignment>left</horizontal-alignment>
            <surface>
                <panel/>
            </surface>
        </flow-layout>

            </children>
    <horizontal-alignment>left</horizontal-alignment>
            <vertical-alignment>center</vertical-alignment>
            <margins>
                <all>5</all>
            </margins>
</flow-layout>
</components>
</owo-ui>
